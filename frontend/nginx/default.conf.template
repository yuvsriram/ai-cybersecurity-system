limit_req_zone $binary_remote_addr zone=analysis_rate:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=analysis_ai_rate:10m rate=6r/m;

limit_conn_zone $binary_remote_addr zone=analysis_ai_conn:10m;


server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;


    #
    # Browser security headers
    #

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    add_header Permissions-Policy
        "camera=(), microphone=(), geolocation=()"
        always;

    add_header Content-Security-Policy
        "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:;"
        always;


    #
    # Public health endpoints
    #

    location = /health/live {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }


    location = /health/ready {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }


    #
    # Non-persistent deterministic log analysis
    #

    location = /api/v1/analyze {
        limit_except POST {
            deny all;
        }

        limit_req zone=analysis_rate burst=10 nodelay;
        limit_req_status 429;

        client_max_body_size 2m;

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
    }


    #
    # Grounded AI explanation
    #
    # Intentionally much more restricted
    # than deterministic analysis.
    #

    location = /api/v1/analyze/explain {
        limit_except POST {
            deny all;
        }

        limit_req zone=analysis_ai_rate burst=2 nodelay;
        limit_req_status 429;

        limit_conn analysis_ai_conn 1;
        limit_conn_status 429;

        client_max_body_size 2m;

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 310s;
        proxy_send_timeout 30s;
    }


    #
    # Events — viewer GET only
    #

    location = /api/v1/events {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    location ~ ^/api/v1/events/[0-9]+$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    #
    # Alerts — viewer GET only
    #

    location = /api/v1/alerts {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    location ~ ^/api/v1/alerts/[^/]+$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    location ~ ^/api/v1/alerts/[^/]+/evidence$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    #
    # Persisted AI investigation history
    #
    # Viewer may inspect existing runs.
    # Queueing new persistent runs is
    # blocked at this edge.
    #

    location ~ ^/api/v1/alerts/[^/]+/investigations$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    location ~ ^/api/v1/alerts/[^/]+/investigations/[^/]+$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    #
    # Cases — viewer GET only
    #

    location = /api/v1/cases {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    location ~ ^/api/v1/cases/[^/]+$ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    #
    # Sanitized public audit stream
    #

    location = /api/v1/audit/public {
        limit_except GET {
            deny all;
        }

        proxy_pass http://api:8000;

        proxy_http_version 1.1;

        proxy_set_header Host api;
        proxy_set_header X-API-Key "${DEMO_API_KEY}";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }


    #
    # Default API deny.
    #
    # Any API route not explicitly allowed
    # above never reaches FastAPI.
    #

    location /api/ {
        return 404;
    }


    #
    # Explicitly do not expose internal
    # operational or API documentation
    # endpoints from the demo frontend.
    #

    location = /metrics {
        return 404;
    }

    location = /openapi.json {
        return 404;
    }

    location = /docs {
        return 404;
    }

    location ^~ /docs/ {
        return 404;
    }

    location = /redoc {
        return 404;
    }


    #
    # React SPA
    #

    location / {
        try_files $uri $uri/ /index.html;
    }
}