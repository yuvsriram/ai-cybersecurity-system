# PostgreSQL
POSTGRES_DB=cybersec
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Used when running the Python application directly on the host.
DATABASE_URL=postgresql+psycopg://cybersec:CHANGE_ME@127.0.0.1:5433/cybersec

# API authentication
# Configure SHA-256 digests of high-entropy API keys.
CYBERSEC_API_KEYS_JSON=[]

# Public demo reverse-proxy credential.
# Never commit the real value.
DEMO_API_KEY=

# API
CYBERSEC_MAX_INGESTION_BYTES=5242880
CYBERSEC_ENVIRONMENT=development
CYBERSEC_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api

# LLM / Ollama
CYBERSEC_LLM_PROVIDER=ollama
CYBERSEC_LLM_MODEL=qwen3:4b
CYBERSEC_LLM_BASE_URL=http://127.0.0.1:11434
CYBERSEC_LLM_TIMEOUT_SECONDS=300
CYBERSEC_LLM_CONTEXT_WINDOW=4096
CYBERSEC_LLM_MAX_OUTPUT_TOKENS=1600
CYBERSEC_LLM_MAX_ATTEMPTS=2
CYBERSEC_LLM_RETRY_BASE_SECONDS=1
CYBERSEC_LLM_MAX_RESPONSE_BYTES=1048576

# Worker
CYBERSEC_WORKER_POLL_SECONDS=2
CYBERSEC_WORKER_METRICS_HOST=127.0.0.1
CYBERSEC_WORKER_METRICS_PORT=9101

# Prometheus API metrics authentication
# Use a cryptographically random value with at least 32 characters.
CYBERSEC_METRICS_TOKEN=

# OpenTelemetry
CYBERSEC_TRACING_ENABLED=true
CYBERSEC_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME